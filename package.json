{
  "name": "giapha",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hệ thống gia phả dòng họ: trang xem cho thành viên + trang quản trị. Chạy trên Cloudflare Workers (D1) hoặc Docker (SQLite).",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch --experimental-strip-types src/server/node.ts",
    "build": "vite build",
    "start": "node --experimental-strip-types src/server/node.ts",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "cf:dev": "vite build && wrangler dev",
    "cf:migrate": "wrangler d1 migrations apply giapha --remote",
    "cf:deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "gdrive:auth": "node --experimental-strip-types scripts/gdrive-auth.ts",
    "migrate-storage": "node --experimental-strip-types scripts/migrate-storage.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.2",
    "d3-zoom": "^3.0.1",
    "hono": "^4.13.21",
    "marked": "^15.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.0",
    "vite": "^8.3.8",
    "wrangler": "^4.168.0"
  }
}
