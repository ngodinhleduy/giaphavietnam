# Bắt buộc: chuỗi ngẫu nhiên >= 32 ký tự. Tạo bằng: openssl rand -hex 32
JWT_SECRET=

# Nơi lưu ảnh: gdrive | local
STORAGE=gdrive

# Google Drive (xem README, mục "Kết nối Google Drive")
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
# Để trống: app tự tạo thư mục "GiaPha-Storage" trong Drive
GDRIVE_FOLDER_ID=

# Khi STORAGE=local (NAS): thư mục chứa ảnh bên trong container
STORAGE_DIR=/data/uploads

# Cloudflare Tunnel (tùy chọn, khi chạy trên NAS)
CF_TUNNEL_TOKEN=
